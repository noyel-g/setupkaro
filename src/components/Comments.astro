---
// Giscus comments (GitHub Discussions backend, free).
// TO ENABLE: 1) repo Settings > enable Discussions, 2) install https://github.com/apps/giscus,
// 3) get IDs at https://giscus.app, 4) fill below + uncomment usage in guide pages.
interface Props { term?: string }
const { term = 'Comments' } = Astro.props;
const ENABLED = false;
const REPO = 'noyel-g/setupkaro';
const REPO_ID = 'REPLACE-ME';
const CATEGORY = 'General';
const CATEGORY_ID = 'REPLACE-ME';
---
{ENABLED && (
<section class="mt-8">
<div class="font-bold mb-2">Discuss this guide</div>
<script src="https://giscus.app/client.js"
  data-repo={REPO}
  data-repo-id={REPO_ID}
  data-category={CATEGORY}
  data-category-id={CATEGORY_ID}
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="light"
  data-lang="en"
  crossorigin="anonymous"
  async></script>
</section>
)}
