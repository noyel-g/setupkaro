---
interface Props { name?: string }
const { name = 'mascot' } = Astro.props;
---
{name === 'mascot' && (
<svg viewBox="0 0 120 130" class="w-full h-auto" role="img" aria-label="SetupKaro buddy doodle">
<circle cx="60" cy="38" r="22" fill="#FDE68A" stroke="#221c15" stroke-width="3.5" stroke-linecap="round"/>
<path d="M42 30 Q48 18 62 20 Q76 22 78 32" fill="none" stroke="#221c15" stroke-width="3.5" stroke-linecap="round"/>
<circle cx="53" cy="38" r="2.6" fill="#221c15"/><circle cx="67" cy="38" r="2.6" fill="#221c15"/>
<path d="M52 48 Q60 54 68 48" fill="none" stroke="#221c15" stroke-width="3" stroke-linecap="round"/>
<path d="M38 66 Q60 58 82 66 L88 110 Q60 118 32 110 Z" fill="#F5B942" stroke="#221c15" stroke-width="3.5" stroke-linejoin="round"/>
<rect x="34" y="86" width="52" height="34" rx="5" fill="#fff" stroke="#221c15" stroke-width="3.5" transform="rotate(-4 60 103)"/>
<rect x="40" y="92" width="40" height="20" rx="2" fill="#8FA8D8" transform="rotate(-4 60 103)"/>
</svg>
)}
{name === 'squiggle' && (
<svg viewBox="0 0 200 14" class="w-full h-3" preserveAspectRatio="none" aria-hidden="true">
<path d="M3 9 Q25 3 50 8 T100 8 T150 7 T197 8" fill="none" stroke="#F59E0B" stroke-width="5" stroke-linecap="round"/>
</svg>
)}
{name === 'arrow' && (
<svg viewBox="0 0 60 40" class="w-12 h-auto" aria-hidden="true">
<path d="M5 5 Q30 5 32 28 M24 21 L32 29 L40 22" fill="none" stroke="#221c15" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
)}
{name === 'sparkles' && (
<svg viewBox="0 0 100 30" class="w-20 h-auto" aria-hidden="true">
<path d="M15 5 L17 12 L24 14 L17 16 L15 23 L13 16 L6 14 L13 12 Z" fill="none" stroke="#221c15" stroke-width="2.5" stroke-linejoin="round"/>
<path d="M55 2 L56.5 7 L61 8.5 L56.5 10 L55 15 L53.5 10 L49 8.5 L53.5 7 Z" fill="#F5B942" stroke="#221c15" stroke-width="2" stroke-linejoin="round"/>
<path d="M85 12 L86 16 L90 17 L86 18 L85 22 L84 18 L80 17 L84 16 Z" fill="none" stroke="#221c15" stroke-width="2" stroke-linejoin="round"/>
</svg>
)}
