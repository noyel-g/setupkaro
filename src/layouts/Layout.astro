---
import '../styles/global.css';
interface Crumb { label: string; href?: string }
interface Props { title: string; desc: string; crumbs?: Crumb[] }
const { title, desc, crumbs = [] } = Astro.props;
---
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title><meta name="description" content={desc} />
<link rel="icon" type="image/svg+xml" href="/logo.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="canonical" href={Astro.url.href} />
<meta property="og:site_name" content="SetupKaro" />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<meta property="og:image" content="/logo.svg" />
<meta name="cuelinks-verification" content="VERIFY-CL-KGOVVHCP" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
<style>
body{font-family:'Inter',system-ui,sans-serif}
.font-hand{font-family:'Caveat',cursive}
.hl{background:linear-gradient(transparent 55%, #FDE68A 55%, #FDE68A 95%, transparent 95%)}
</style>
</head>
<body class="bg-[#FBF7F0] text-[#221c15] min-h-screen">
<header class="sticky top-0 z-10 bg-[#FBF7F0]/95 backdrop-blur border-b-[3px] border-[#221c15]">
<div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-5">
<a href="/" class="font-extrabold text-lg tracking-tight whitespace-nowrap flex items-center gap-2"><img src="/logo.svg" alt="SetupKaro logo" class="w-8 h-8" /><span>Setup<span class="text-indigo-600">Karo</span></span></a>
<nav class="text-sm hidden sm:flex gap-5 font-bold">
<a href="/build" class="hover:bg-[#FDE68A] rounded-full px-2">Build</a>
<a href="/circle" class="hover:bg-[#FDE68A] rounded-full px-2">Setups</a>
<a href="/products" class="hover:bg-[#FDE68A] rounded-full px-2">Products</a>
<a href="/tools" class="hover:bg-[#FDE68A] rounded-full px-2">Tools</a>
<a href="/guides" class="hover:bg-[#FDE68A] rounded-full px-2">Guides</a>
</nav>
<a href="/circle" class="sm:hidden text-xl ml-auto">☰</a>
<a href="/build" class="hidden sm:inline-block ml-auto text-sm font-bold border border-[#221c15] rounded-full px-4 py-1.5 hover:bg-[#221c15] hover:text-white">Start building →</a>
</div>
</header>
{crumbs.length > 0 && (
<nav class="max-w-5xl mx-auto px-4 pt-4 text-xs text-gray-500 flex gap-1 items-center">
{crumbs.map((c, i) => (
<span class="flex gap-1 items-center">
{i > 0 && <span>›</span>}
{c.href ? <a href={c.href} class="hover:text-indigo-600">{c.label}</a> : <span class="text-gray-700 font-medium">{c.label}</span>}
</span>
))}
</nav>
)}
<slot />
<footer class="max-w-5xl mx-auto px-4 pb-10 pt-6 mt-6 text-sm">
<div class="dk-card p-6 grid sm:grid-cols-4 gap-6">
<div>
<div class="font-extrabold flex items-center gap-2"><img src="/logo.svg" alt="" class="w-6 h-6" />SetupKaro</div>
<p class="text-xs text-gray-500 mt-2">Dream Setup. Real Plan.</p>
</div>
<div>
<div class="font-bold text-xs tracking-wide text-gray-500">PRODUCT</div>
<div class="mt-2 flex flex-col gap-1 text-sm"><a href="/build" class="hover:underline">Build a Setup</a><a href="/circle" class="hover:underline">Community</a><a href="/tools" class="hover:underline">Tools</a><a href="/guides" class="hover:underline">Guides</a></div>
</div>
<div>
<div class="font-bold text-xs tracking-wide text-gray-500">COMPANY</div>
<div class="mt-2 flex flex-col gap-1 text-sm"><a href="/about" class="hover:underline">About</a><a href="/contact" class="hover:underline">Contact</a><a href="/privacy" class="hover:underline">Privacy</a><a href="/affiliate-disclosure" class="hover:underline">Disclosure</a></div>
</div>
<div>
<div class="font-bold text-xs tracking-wide text-gray-500">CONNECT</div>
<div class="mt-2 flex flex-col gap-1 text-sm"><span>Telegram (soon)</span><span>YouTube (soon)</span><a href="/contact" class="hover:underline">Newsletter</a></div>
</div>
</div>
<div class="text-center text-xs text-gray-500 mt-3">Good people build great setups. © 2026 SetupKaro. All rights reserved. <span class="font-hand text-base">Keep building ✌</span></div>
</footer>
</body>
</html>
