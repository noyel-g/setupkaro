---
import '../styles/global.css';
interface Crumb { label: string; href?: string }
interface Props { title: string; desc: string; crumbs?: Crumb[] }
const { title, desc, crumbs = [] } = Astro.props;
---
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title><meta name="description" content={desc} />
<meta name="cuelinks-verification" content="VERIFY-CL-KGOVVHCP" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
<style>body{font-family:'Inter',system-ui,sans-serif}</style>
</head>
<body class="bg-[#FAFAF9] text-[#171717] min-h-screen">
<header class="sticky top-0 z-10 bg-white/95 backdrop-blur border-b border-[#E5E5E5]">
<div class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-6">
<a href="/" class="font-extrabold text-lg tracking-tight whitespace-nowrap">⚙️ Setup<span class="text-indigo-600">Karo</span></a>
<nav class="text-sm hidden sm:flex gap-5 font-medium text-gray-700">
<a href="/" class="hover:text-indigo-600">Home</a>
<a href="/#tools" class="hover:text-indigo-600">Tools</a>
<a href="/#tools" class="hover:text-indigo-600">Guides</a>
<a href="/about" class="hover:text-indigo-600">About</a>
</nav>
<span class="sm:hidden text-xl ml-auto">☰</span>
</div>
</header>
{crumbs.length > 0 && (
<nav class="max-w-5xl mx-auto px-4 pt-4 text-xs text-gray-500 flex gap-1 items-center">
{crumbs.map((c, i) => (
<span class="flex gap-1 items-center">
{i > 0 && <span>›</span>}
{c.href ? <a href={c.href} class="hover:text-indigo-600">{c.label}</a> : <span class="text-gray-700 font-medium">{c.label}</span>}
</span>
))}
</nav>
)}
<slot />
<footer class="max-w-5xl mx-auto px-4 pb-10 pt-6 mt-6 text-xs text-gray-500">
<div class="bg-white rounded-2xl border p-4 flex flex-wrap gap-x-5 gap-y-2 justify-center">
<a href="/" class="hover:underline">Home</a><a href="/about" class="hover:underline">About</a><a href="/contact" class="hover:underline">Contact</a><a href="/privacy" class="hover:underline">Privacy</a><a href="/affiliate-disclosure" class="hover:underline">Affiliate Disclosure</a>
</div>
<div class="text-center mt-3">© 2026 SetupKaro.in • Made for India</div>
</footer>
</body>
</html>
