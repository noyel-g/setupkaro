---
import '../styles/global.css';
interface Props { title: string; desc: string; }
const { title, desc } = Astro.props;
---
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title><meta name="description" content={desc} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
<style>body{font-family:'Inter',system-ui,sans-serif}</style>
</head>
<body class="bg-[#faf9f7] text-gray-900 min-h-screen">
<header class="sticky top-0 z-10 bg-[#faf9f7]/90 backdrop-blur border-b">
<div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
<a href="/" class="font-extrabold text-lg tracking-tight">⚙️ Setup<span class="text-indigo-600">Karo</span></a>
<nav class="text-sm flex gap-4 font-semibold">
<a href="/" class="hover:text-indigo-600">Home</a>
<a href="/tools/freelance-rate-calculator" class="hover:text-indigo-600 hidden sm:inline">Calculators</a>
<a href="/best-mic-under-2000" class="hover:text-indigo-600 hidden sm:inline">Guides</a>
<a href="/about" class="hover:text-indigo-600">About</a>
</nav>
</div>
</header>
<slot />
<footer class="max-w-5xl mx-auto px-4 pb-10 pt-6 mt-6 border-t text-xs text-gray-500 flex flex-wrap gap-x-4 gap-y-2 justify-center">
<a href="/" class="hover:underline">Home</a><a href="/about" class="hover:underline">About</a><a href="/contact" class="hover:underline">Contact</a><a href="/privacy" class="hover:underline">Privacy</a><a href="/affiliate-disclosure" class="hover:underline">Affiliate Disclosure</a>
<span class="w-full text-center mt-2">© 2026 SetupKaro.in • Made for India</span>
</footer>
</body>
</html>
