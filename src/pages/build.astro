---
import Layout from '../layouts/Layout.astro';
const types = [
  { t: 'gaming', icon: '🎮', name: 'Gaming', sub: 'High FPS. Low stress.' },
  { t: 'office', icon: '💻', name: 'Work From Home', sub: 'Focus. Productivity.' },
  { t: 'creator', icon: '🎙️', name: 'Creator Corner', sub: 'Video. Audio. Content.' },
  { t: 'study', icon: '📖', name: 'Study Setup', sub: 'Learn. Grow.' },
  { t: 'room', icon: '🪴', name: 'Room Makeover', sub: 'Aesthetic. Cozy. You.' },
  { t: 'creator', icon: '•••', name: 'Something else', sub: 'Custom setup' },
];
---
<Layout title="Build my setup - SetupKaro" desc="Answer 5 quick questions. Get a setup plan with real INR prices.">
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="bg-white rounded-2xl border border-[#E8E0D3] mt-4 p-6 sm:p-8 max-w-2xl mx-auto">
<div class="flex items-center gap-3 text-sm">
<a href="/" class="text-gray-500">← Back</a>
<div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden"><div id="bar" class="h-full bg-green-500 rounded-full" style="width:20%"></div></div>
<span id="stepN" class="text-xs text-gray-500">Step 1 of 5</span>
</div>

<section data-step="1">
<h1 class="text-2xl sm:text-3xl font-extrabold mt-4">What are you building?</h1>
<p class="text-sm text-gray-500">Pick a vibe. You can always change it later.</p>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-4" id="types">
{types.map((c, i) => (
<button data-t={c.t} class={`type-btn border rounded-2xl p-4 text-left ${i===0?'border-amber-500 bg-amber-50':'hover:border-gray-400'}`}>
<div class="text-3xl">{c.icon}</div><div class="font-bold text-sm mt-1">{c.name}</div><div class="text-xs text-gray-500">{c.sub}</div>
</button>
))}
</div>
<p class="font-hand text-xl mt-4 text-gray-600">Different people. Different setups. Same good vibes.</p>
</section>

<section data-step="2" class="hidden">
<h1 class="text-2xl sm:text-3xl font-extrabold mt-4">What's your budget?</h1>
<p class="text-sm text-gray-500">Slide to set your range. We'll make it count.</p>
<div class="text-center mt-4"><span id="bOut" class="bg-amber-400 font-extrabold px-4 py-1.5 rounded-lg">₹40,000</span></div>
<input id="budget" type="range" min="10000" max="100000" step="5000" value="40000" class="w-full accent-amber-500 mt-4" />
<div class="flex justify-between text-xs text-gray-500 mt-1"><span>₹10K</span><span>₹20K</span><span>₹30K</span><span>₹50K</span><span>₹75K</span><span>₹1L+</span></div>
<p class="font-hand text-xl mt-4 text-gray-600">Nice! We can build something great at <span id="bOut2">₹40,000</span>.</p>
</section>

<section data-step="3" class="hidden">
<h1 class="text-2xl sm:text-3xl font-extrabold mt-4">How are you actually going to use it?</h1>
<p class="text-sm text-gray-500">Pick all that apply.</p>
<div class="flex flex-wrap gap-2 mt-4" id="uses">
{['Gaming','Work','Study','Editing','Streaming','Music','Content Creation','General Use'].map((u) => (
<button data-u={u} class="use-pill border rounded-full px-4 py-2 text-sm font-semibold hover:border-gray-400">{u}</button>
))}
</div>
<p class="font-hand text-xl mt-4 text-gray-600">Be honest. This helps us pick the right gear.</p>
</section>

<section data-step="4" class="hidden">
<h1 class="text-2xl sm:text-3xl font-extrabold mt-4">How many hours will you spend here?</h1>
<div class="space-y-2 mt-4" id="hours">
{['Under 2 hours','2 – 5 hours','5 – 8 hours','8+ hours'].map((h, i) => (
<label class={`flex items-center gap-3 border rounded-xl px-4 py-3 text-sm font-semibold cursor-pointer ${i===2?'border-amber-500 bg-amber-50':''}`}>
<input type="radio" name="hrs" value={h} checked={i===2} class="accent-amber-600" />{h}
</label>
))}
</div>
<p class="font-hand text-xl mt-4 text-gray-600">Your back will thank you.</p>
</section>

<section data-step="5" class="hidden">
<h1 class="text-2xl sm:text-3xl font-extrabold mt-4">What's your priority?</h1>
<div class="space-y-2 mt-4" id="prios">
{['Maximum performance','Balanced','Comfort','Aesthetic','Minimal','Cozy'].map((p, i) => (
<label class={`flex items-center gap-3 border rounded-xl px-4 py-3 text-sm cursor-pointer ${i===1?'border-amber-500 bg-amber-50':''}`}>
<input type="radio" name="prio" value={p} checked={i===1} class="accent-amber-600" />{p}
</label>
))}
</div>
<p class="font-hand text-xl mt-4 text-gray-600">No wrong answers. Just a better setup.</p>
</section>

<div class="flex justify-between mt-6">
<button id="back" class="text-sm font-bold border rounded-full px-5 py-2.5 invisible">← Back</button>
<button id="next" class="text-sm font-bold bg-amber-400 rounded-full px-6 py-2.5 hover:bg-amber-500">Next →</button>
</div>
</div>
</main>
<script>
let step = 1, type = new URLSearchParams(location.search).get('type') || 'gaming';
const secs = Array.from(document.querySelectorAll('[data-step]'));
function show(){
  secs.forEach(s => s.classList.toggle('hidden', +s.dataset.step !== step));
  document.getElementById('bar').style.width = (step*20) + '%';
  document.getElementById('stepN').innerText = 'Step ' + step + ' of 5';
  document.getElementById('back').classList.toggle('invisible', step === 1);
  document.getElementById('next').innerText = step === 5 ? 'Generate my setup →' : 'Next →';
  document.querySelectorAll('.type-btn').forEach(b => {
    const on = b.dataset.t === type;
    b.className = 'type-btn border rounded-2xl p-4 text-left ' + (on ? 'border-amber-500 bg-amber-50' : 'hover:border-gray-400');
  });
}
document.querySelectorAll('.type-btn').forEach(b => b.addEventListener('click', () => { type = b.dataset.t; show(); }));
const budget = document.getElementById('budget');
function fmt(n){ return '₹' + (+n).toLocaleString('en-IN'); }
budget.addEventListener('input', () => {
  document.getElementById('bOut').innerText = fmt(budget.value);
  document.getElementById('bOut2').innerText = fmt(budget.value);
});
document.querySelectorAll('.use-pill').forEach(p => p.addEventListener('click', () => {
  const on = p.classList.toggle('bg-amber-100');
  p.classList.toggle('border-amber-500', on);
}));
document.getElementById('back').addEventListener('click', () => { if (step > 1) { step--; show(); } });
document.getElementById('next').addEventListener('click', () => {
  if (step < 5) { step++; show(); return; }
  const uses = Array.from(document.querySelectorAll('.use-pill.bg-amber-100')).map(p => p.dataset.u).join(',');
  const hrs = (document.querySelector('input[name=hrs]:checked') || {}).value || '';
  const prio = (document.querySelector('input[name=prio]:checked') || {}).value || 'Balanced';
  const q = new URLSearchParams({ type, budget: budget.value, uses, hrs, prio });
  location.href = '/setup-result?' + q.toString();
});
show();
</script>
</Layout>
