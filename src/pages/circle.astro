---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Real setups. Real people. - SetupKaro Circle" desc="Get inspired by setups from the SetupKaro community. Good fellas. Same dream.">
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="dk-card mt-4 p-6 sm:p-8" style="background:#fffdf7">
<div class="text-xs font-bold tracking-wide text-indigo-600">THE CIRCLE</div>
<h1 class="text-2xl sm:text-3xl font-extrabold mt-1">Real setups. Real people.</h1>
<p class="text-sm text-gray-500 mt-1">Get inspired by setups from the SetupKaro community. Small, honest, no hype.</p>
<div class="flex flex-wrap gap-2 mt-4 text-xs font-bold">
{['All', 'Gaming', 'Work', 'Creator', 'Study', 'Room'].map((c, i) => (
<span class={`border rounded-full px-4 py-1.5 ${i===0?'bg-[#221c15] text-white':''}`}>{c}</span>
))}
</div>
<div class="grid sm:grid-cols-2 gap-3 mt-4">
<div class="border border-[#E8E0D3] rounded-xl overflow-hidden">
<div class="bg-gradient-to-br from-amber-100 to-orange-100 h-36 flex items-center justify-center text-5xl">🖥️</div>
<div class="p-4 flex items-center justify-between">
<div><div class="font-extrabold">₹3,000</div><div class="text-xs text-gray-500">Noyel's corner • by Noyel G</div></div>
<a href="/contact" class="text-sm font-bold">→</a>
</div>
</div>
{[1, 2, 3].map(() => (
<div class="border border-dashed border-gray-300 rounded-xl p-6 text-center">
<div class="font-hand text-2xl text-gray-400">Your setup here?</div>
<p class="text-xs text-gray-500 mt-1">Build it with the planner, send photo + budget via contact.</p>
<a href="/build" class="inline-block mt-3 text-sm font-bold border rounded-full px-4 py-2">Plan mine →</a>
</div>
))}
</div>
<div class="flex flex-wrap gap-2 mt-4">
<a href="/contact" class="dk-btn text-sm">+ Submit your setup</a>
<a href="/build" class="text-sm font-bold border rounded-full px-5 py-2.5">Build first →</a>
</div>
<div class="mt-6 text-sm leading-7 max-w-xl">
<div class="font-bold">Circle values</div>
<p class="text-gray-600">Real over rich • Help, don't sell • Small stays small. Full manifesto + how to join on request — say hello via <a href="/contact" class="text-indigo-700 font-bold">contact</a>.</p>
</div>
</div>
</main>
</Layout>
