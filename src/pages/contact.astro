---
const title = "SetupKaro";
const desc = "SetupKaro";
import Layout from '../layouts/Layout.astro';
---
<Layout title={title} desc={desc}>
<main class="max-w-3xl mx-auto px-4 py-8">
<a href="/" class="text-indigo-700 font-bold text-sm">← SetupKaro</a>
<h1 class="text-3xl font-extrabold mt-2">Contact</h1>
<p class="mt-3">Mail: <b>hello@setupkaro.in</b> (reply in 2-3 days)</p>
<p class="mt-2 text-sm text-gray-600">For price corrections, tool ideas, affiliate disclosure questions. Include page URL + screenshot.</p>
</main>
</Layout>
