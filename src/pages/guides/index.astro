---
import Layout from '../../layouts/Layout.astro';
const guides = [
  { href: '/guides/best-mic-under-2000', name: 'Best Mic Under ₹2000', sub: 'Noisy-room picks. What I actually bought.' },
  { href: '/guides/hosting-for-portfolio', name: 'Hosting for Portfolio', sub: 'Under ₹2000/yr, renewal traps explained.' },
  { href: '/guides/fiverr-vs-upwork-fees-india', name: 'Fiverr vs Upwork Fees', sub: '$100 compared in INR.' },
];
---
<Layout title="Guides without the nonsense - SetupKaro" desc="Practical, no-fluff guides to help you build better setups." crumbs={[{label:'Home',href:'/'},{label:'Guides'}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="dk-card mt-4 p-6 sm:p-8" style="background:#fffdf7">
<h1 class="text-2xl sm:text-3xl font-extrabold">Guides without the nonsense.</h1>
<p class="text-sm text-gray-500 mt-1">Practical, no-fluff guides to help you build better setups.</p>
<div class="grid sm:grid-cols-3 gap-3 mt-5">
{guides.map((g) => (
<a href={g.href} class="border border-[#E8E0D3] rounded-xl p-5 block hover:border-gray-400">
<span class="font-semibold block">{g.name}</span>
<span class="text-sm text-gray-500 block mt-1">{g.sub}</span>
<span class="text-sm font-semibold block mt-3">Read →</span>
</a>
))}
</div>
</div>
</main>
</Layout>
