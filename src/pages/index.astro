---
import Layout from '../layouts/Layout.astro';
const tools = [
  { href: '/tools/freelance-rate-calculator', cat: 'EARN', name: 'Freelance Rate Calculator', sub: 'Know what to charge per hour in INR, with Upwork cut included.' },
  { href: '/tools/upwork-fees-calculator', cat: 'EARN', name: 'Upwork Fees Calculator', sub: 'See your actual INR payout after fees.' },
  { href: '/tools/editing-rate-calculator', cat: 'EARN', name: 'Editing Rate Calculator', sub: 'Price video editing work per minute.' },
  { href: '/tools/youtube-setup-under-5000', cat: 'CREATE', name: 'YouTube Setup Under ₹5000', sub: 'Starter gear checklist with real prices.' },
  { href: '/guides/best-mic-under-2000', cat: 'CREATE', name: 'Best Mic Under ₹2000', sub: 'Tested in a noisy room. What I actually bought.' },
  { href: '/guides/hosting-for-portfolio', cat: 'BUILD', name: 'Hosting for Portfolio', sub: 'Portfolio hosting under ₹2000/yr, renewal traps explained.' },
];
---
<Layout title="Freelance Rate Calculator India, Upwork Fees & Budget Setup Guides - SetupKaro" desc="Free freelance rate calculator India, Upwork fees calculator in INR, video editing rates and budget YouTube setup guides. Built for Indian creators and freelancers.">
<main class="max-w-5xl mx-auto px-4 pb-10" id="tools">
<div class="bg-white rounded-2xl border mt-4 p-6 sm:p-8">
<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Useful tools for getting work done.</h1>
<p class="text-gray-600 mt-2">Calculators, guides and resources for creators and freelancers in India.</p>
<p class="text-sm text-gray-500 mt-1">Free to use &nbsp;•&nbsp; Made for India &nbsp;•&nbsp; No login</p>
<div class="mt-4 relative max-w-xl">
<input id="q" type="search" placeholder="Search tools, guides and calculators..." class="w-full border rounded-full py-2.5 pl-10 pr-4 text-sm outline-none focus:border-indigo-500" />
<span class="absolute left-4 top-2.5 text-gray-400">🔍</span>
</div>
<div class="font-bold mt-7 mb-3">Popular tools</div>
<div id="grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
{tools.map((t) => (
<a href={t.href} data-name={(t.name + ' ' + t.sub).toLowerCase()} class="tool-card bg-white border border-[#E5E5E5] rounded-xl p-5 block hover:border-gray-400">
<span class="text-[11px] font-bold tracking-wide text-indigo-600">{t.cat}</span>
<span class="font-semibold block mt-1 leading-snug">{t.name}</span>
<span class="text-sm text-gray-600 block mt-1">{t.sub}</span>
<span class="text-sm font-semibold text-gray-900 block mt-3">Open →</span>
</a>
))}
</div>
</div>
</main>
<script>
const q = document.getElementById('q');
const cards = Array.from(document.querySelectorAll('.tool-card'));
q.addEventListener('input', () => {
  const s = q.value.toLowerCase().trim();
  cards.forEach(c => { c.style.display = !s || c.dataset.name.includes(s) ? '' : 'none'; });
});
</script>
</Layout>
