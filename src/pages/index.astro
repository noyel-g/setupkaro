---
import Layout from '../layouts/Layout.astro';
---
<Layout title="SetupKaro - Budget Creator & Freelancer Setup India" desc="Free tools + honest budget comparisons for Indian YouTubers and freelancers. Start with mobile + Rs 2000.">
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="text-center pt-10">
<div class="text-xs font-bold bg-green-100 text-green-700 inline-block px-3 py-1 rounded-full">MADE FOR INDIA • FREE • NO LOGIN</div>
<h1 class="text-4xl sm:text-5xl font-extrabold mt-4 tracking-tight leading-tight">Start earning with<br/>what you have.</h1>
<p class="text-gray-600 mt-3 text-lg">Calculators + budget gear in INR. No hype.</p>
<div class="flex gap-2 justify-center mt-4 text-xs font-bold">
<span class="bg-white border rounded-full px-3 py-1">1 Calculate rate</span>
<span class="bg-white border rounded-full px-3 py-1">2 Build setup</span>
<span class="bg-white border rounded-full px-3 py-1">3 Get clients</span>
</div>
</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-8">
<a href="/tools/freelance-rate-calculator" class="bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md block">
<div class="text-2xl">💰</div><div class="font-bold mt-1">Freelance Rate Calculator</div><div class="text-sm text-gray-600">Hourly INR with Upwork cut</div>
</a>
<a href="/tools/upwork-fees-calculator" class="bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md block">
<div class="text-2xl">💵</div><div class="font-bold mt-1">Upwork Fees 2026</div><div class="text-sm text-gray-600">$ → INR in hand</div>
</a>
<a href="/tools/editing-rate-calculator" class="bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md block">
<div class="text-2xl">✂️</div><div class="font-bold mt-1">Editing Rate / Minute</div><div class="text-sm text-gray-600">Reels / YouTube / Wedding</div>
</a>
<a href="/tools/budget-builder" class="bg-white border rounded-2xl p-5 shadow-sm hover:shadow-md block">
<div class="text-2xl">🎬</div><div class="font-bold mt-1">Budget Builder 5000</div><div class="text-sm text-gray-600">Mic + light + tripod total</div>
</a>
</div>

<div class="mt-4 grid sm:grid-cols-2 gap-3">
<a href="/best-mic-under-2000" class="bg-gray-900 text-white rounded-2xl p-5 block">
<div class="text-xs opacity-70 font-bold">GUIDE • 2026</div><div class="font-bold mt-1">Best Mic Under 2000 →</div><div class="text-sm opacity-70">Noisy-room picks, Boya vs K8</div>
</a>
<a href="/hosting-for-portfolio" class="bg-indigo-600 text-white rounded-2xl p-5 block">
<div class="text-xs opacity-80 font-bold">PORTFOLIO • UNDER 2000/YR</div><div class="font-bold mt-1">Hosting for Portfolio →</div><div class="text-sm opacity-80">Renewal trap + free option</div>
</a>
</div>
</main>
</Layout>
