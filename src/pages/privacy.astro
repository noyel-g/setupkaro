---
const title = "SetupKaro";
const desc = "SetupKaro";
import Layout from '../layouts/Layout.astro';
---
<Layout title={title} desc={desc}>
<main class="max-w-3xl mx-auto px-4 py-8">
<a href="/" class="text-indigo-700 font-bold text-sm">← SetupKaro</a>
<h1 class="text-3xl font-extrabold mt-2">Privacy Policy</h1>
<p class="mt-3 leading-7 text-sm">We use Cloudflare Web Analytics and Google Search Console (privacy-friendly, no cookies for calculators). All calculators run in your browser - inputs never leave your phone. Contact mail hello@setupkaro.in is only used to reply. Affiliate clicks go to Amazon/Flipkart/Hostinger under their privacy policies.</p>
<p class="mt-2 text-sm text-gray-600">Effective: 6 Sept 2026.</p>
</main>
</Layout>
