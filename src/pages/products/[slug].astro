---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<Layout title={`${p.name} - SetupKaro`} desc={p.verdict} crumbs={[{label:'Home',href:'/'},{label:'Products',href:'/products'},{label:p.name}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="bg-white rounded-2xl border border-[#E8E0D3] mt-4 p-6 sm:p-8 max-w-2xl">
<div class="text-xs text-gray-500">By Noyel G • Price checked Sept 2026 • Real-use verdict</div>
<h1 class="text-2xl sm:text-3xl font-extrabold mt-1">{p.name}</h1>
<p class="text-sm text-gray-500 capitalize">{p.slot} • {p.tier} pick</p>
<div class="text-3xl font-extrabold mt-2">₹{p.price.toLocaleString('en-IN')} <span class="text-xs font-normal text-gray-500">(price moves — check live)</span></div>
<div class="flex gap-2 mt-3">
<a href="#" rel="nofollow sponsored" class="text-sm font-bold bg-[#221c15] text-white rounded-full px-5 py-2.5">Buy on Amazon →</a>
<a href="#" rel="nofollow sponsored" class="text-sm font-bold border rounded-full px-5 py-2.5">Check price →</a>
</div>

<div class="bg-green-50 border border-green-200 rounded-2xl p-4 mt-5 text-sm leading-7">
<b>SetupKaro Verdict:</b> {p.verdict}
</div>

<div class="grid grid-cols-2 gap-2 mt-4 text-sm">
<div class="border rounded-xl p-3"><b>Best for</b><div class="text-gray-600 text-xs mt-1">{p.bestFor}</div></div>
<div class="border rounded-xl p-3"><b>Skip if</b><div class="text-gray-600 text-xs mt-1">{p.skipIf}</div></div>
</div>

<div class="mt-4 text-sm space-y-2">
{Object.entries(p.ratings).map(([k, v]) => (
<div class="flex items-center gap-3">
<span class="w-28 text-gray-600">{k}</span>
<div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full bg-amber-400 rounded-full" style={`width:${v * 10}%`}></div></div>
<span class="font-bold w-8 text-right">{v}/10</span>
</div>
))}
</div>

<details class="border rounded-2xl p-4 mt-4 text-sm" open>
<summary class="font-bold cursor-pointer">What it feels like to use</summary>
<p class="mt-2 text-gray-600 leading-7">{p.why}</p>
</details>
<details class="border rounded-2xl p-4 mt-2 text-sm">
<summary class="font-bold cursor-pointer">Pros & cons</summary>
<div class="grid sm:grid-cols-2 gap-3 mt-2">
<div><div class="font-bold text-green-700 text-xs">PROS</div><ul class="mt-1 space-y-1">{p.pros.map((x) => <li>✓ {x}</li>)}</ul></div>
<div><div class="font-bold text-red-600 text-xs">CONS</div><ul class="mt-1 space-y-1">{p.cons.map((x) => <li>✗ {x}</li>)}</ul></div>
</div>
</details>
<details class="border rounded-2xl p-4 mt-2 text-sm">
<summary class="font-bold cursor-pointer">Specs</summary>
<div class="mt-2 divide-y">{Object.entries(p.specs).map(([k, v]) => <div class="flex justify-between py-1.5"><span class="text-gray-500">{k}</span><b>{v}</b></div>)}</div>
</details>
<p class="text-sm mt-4"><a href="/build" class="text-indigo-700 font-bold">← Plan a setup with this part</a></p>
</div>
</main>
</Layout>
