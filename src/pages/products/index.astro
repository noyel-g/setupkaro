---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
const slots = [...new Set(products.map((p) => p.slot))];
---
<Layout title="Products - hand-picked setup parts | SetupKaro" desc="Every part we recommend, with honest verdicts and INR prices." crumbs={[{label:'Home',href:'/'},{label:'Products'}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="dk-card mt-4 p-6 sm:p-8" style="background:#fffdf7">
<h1 class="text-2xl sm:text-3xl font-extrabold">Products worth your money.</h1>
<p class="text-sm text-gray-500 mt-1">Hand-picked, honestly reviewed. {products.length} parts and counting.</p>
<div class="flex flex-wrap gap-2 mt-4" id="pills">
<button data-s="all" class="pill text-xs font-bold border rounded-full px-4 py-1.5 bg-[#221c15] text-white">All</button>
{slots.map((s) => <button data-s={s} class="pill text-xs font-bold border rounded-full px-4 py-1.5 capitalize">{s}</button>)}
</div>
<div id="grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">
{products.map((p) => (
<a href={`/products/${p.slug}`} data-slot={p.slot} data-name={(p.name + ' ' + p.slot).toLowerCase()} class="prod border border-[#E8E0D3] rounded-xl p-4 hover:border-gray-400 block">
<div class="flex items-center justify-between"><span class="text-2xl">{p.icon}</span><b>₹{p.price.toLocaleString('en-IN')}</b></div>
<div class="font-semibold text-sm mt-2">{p.name}</div>
<div class="text-xs text-gray-500 mt-1 line-clamp-2">{p.verdict}</div>
</a>
))}
</div>
</div>
</main>
<script>
const pills = Array.from(document.querySelectorAll('.pill'));
const cards = Array.from(document.querySelectorAll('.prod'));
pills.forEach(b => b.addEventListener('click', () => {
  pills.forEach(x => { x.classList.remove('bg-[#221c15]', 'text-white'); });
  b.classList.add('bg-[#221c15]', 'text-white');
  const s = b.dataset.s;
  cards.forEach(c => { c.style.display = (s === 'all' || c.dataset.slot === s) ? '' : 'none'; });
}));
</script>
</Layout>
