---
import '../../styles/global.css';
const title = "YouTube Budget Builder Under Rs 5000 / 10000 India - SetupKaro";
const desc = "Build your YouTube starter setup under Rs 5000 or Rs 10000 in India. Mic, light, tripod with real INR prices.";
const items = [
  { id: 'boya', name: 'Boya BY-M1 Mic (wired, best starter)', price: 999, tag: 'Must have' },
  { id: 'k8', name: 'K8 Wireless Mic (Type-C + iPhone)', price: 1499, tag: 'Reels' },
  { id: 'light', name: '10-inch Ring Light with stand', price: 899, tag: 'Face videos' },
  { id: 'tripod', name: 'Mini Tripod + mobile holder', price: 499, tag: 'Must have' },
  { id: 'fifine', name: 'Fifine K669B USB Mic (PC)', price: 2549, tag: 'PC setup' },
  { id: 'grenaro', name: 'Grenaro Dual Wireless (pro)', price: 1999, tag: 'Upgrade' },
];
---
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title><meta name="description" content={desc} />
</head>
<body class="bg-gradient-to-b from-amber-50 to-white min-h-screen text-gray-900">
<header class="max-w-2xl mx-auto px-4 pt-6 flex items-center justify-between">
<a href="/" class="font-extrabold text-indigo-700 text-lg">⚙️ SetupKaro</a>
<span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full">INR prices</span>
</header>
<main class="max-w-2xl mx-auto px-4 pb-10">
<h1 class="text-3xl font-extrabold mt-4">YouTube setup under Rs 5000?</h1>
<p class="text-gray-600 mt-1">Tick what you need. Total updates live. No overspending.</p>

<div class="bg-gray-900 text-white rounded-2xl px-5 py-4 mt-5 flex justify-between items-center">
<div><div class="text-xs opacity-70">TOTAL</div><div id="total" class="text-3xl font-extrabold">Rs 0</div><div id="msg" class="text-xs opacity-80"></div></div>
<div id="badge" class="text-xs bg-green-500 px-2 py-1 rounded-full font-bold">Under 5000 ✅</div>
</div>

<div class="space-y-3 mt-4" id="list">
{items.map((it) => (
<label class="bg-white border rounded-2xl p-4 flex gap-3 items-start shadow-sm block cursor-pointer">
<input type="checkbox" data-price={it.price} data-name={it.name} class="mt-1 w-5 h-5 accent-indigo-600 chk" checked={it.id==='boya' || it.id==='tripod'} />
<div class="flex-1">
<div class="font-bold">{it.name}</div>
<div class="text-sm text-gray-600">Rs {it.price.toLocaleString('en-IN')} • {it.tag}</div>
<a href="#" class="text-xs text-blue-600 font-bold">Check price →</a>
</div>
</label>
))}
</div>

<div class="bg-indigo-600 text-white rounded-2xl p-5 mt-4 text-center">
<div class="font-bold">Confused mic vs wireless?</div>
<div class="text-sm opacity-80">Take 30-sec quiz (coming)</div>
</div>

<div class="mt-5 text-sm leading-6 bg-white border rounded-2xl p-4">
<h2 class="font-bold">Best combo under Rs 5000</h2>
<p>Boya M1 Rs 999 + Tripod Rs 499 + Ring light Rs 899 = Rs 2397. Enough for Reels + YouTube. Add wireless later when you earn. Don't buy Rs 500 no-name mics - no noise cancellation for fan/traffic.</p>
</div>
</main>
<script>
function upd(){
let t=0; document.querySelectorAll('.chk:checked').forEach(c=>t+=+c.dataset.price);
document.getElementById('total').innerText='Rs '+t.toLocaleString('en-IN');
const b=document.getElementById('badge');
const m=document.getElementById('msg');
if(t<=5000){b.innerText='Under 5000 ✅';b.className='text-xs bg-green-500 px-2 py-1 rounded-full font-bold';m.innerText='Perfect starter - start creating';}
else if(t<=10000){b.innerText='Under 10000 👍';b.className='text-xs bg-yellow-500 text-black px-2 py-1 rounded-full font-bold';m.innerText='Semi-pro - okay if PC videos';}
else{b.innerText='Over budget ⚠️';b.className='text-xs bg-red-500 px-2 py-1 rounded-full font-bold';m.innerText='Remove one item - start small';}
}
document.querySelectorAll('.chk').forEach(c=>c.addEventListener('change',upd));upd();
</script>
</body>
</html>
