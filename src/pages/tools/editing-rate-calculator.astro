---
import Layout from '../../layouts/Layout.astro';
const title = "Editing Rate Calculator - SetupKaro";
const desc = "Reels edit ≠ YouTube edit. Select type, get your price in INR.";
---
<Layout title={title} desc={desc} crumbs={[{label:'Home',href:'/'},{label:'Tools',href:'/#tools'},{label:'Editing Rate Calculator'}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="bg-white rounded-3xl border mt-4 p-6 sm:p-8">
<div class="text-xs text-gray-500">By Noyel G • Updated 6 Sept 2026</div>
<h1 class="text-2xl sm:text-3xl font-extrabold mt-1">Video editing: per minute charge?</h1>
<p class="text-sm text-gray-600 mt-1">Reels edit ≠ YouTube edit. Select type, get your price in INR.</p>

<div class="mt-5 max-w-xl border rounded-2xl p-5">
<label class="text-sm font-semibold block">Video length (minutes)<input id="len" type="number" value="5" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block mt-3">Type
<select id="type" class="mt-1 w-full border rounded-xl p-2.5 bg-white">
<option value="800">YouTube vlog - ₹1500/min</option>
<option value="1500" selected>YouTube vlog - ₹1500/min</option>
<option value="2500">Wedding / cinematic - ₹2500/min</option>
<option value="800">Reels / Shorts - ₹800/min</option>
<option value="500">Raw cut only - ₹500/min</option>
</select></label>
<div class="grid grid-cols-2 gap-3 mt-3">
<label class="text-sm font-semibold block">Revisions
<select id="rev" class="mt-1 w-full border rounded-xl p-2.5 bg-white"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option></select></label>
<label class="text-sm font-semibold block">Urgent?
<select id="urg" class="mt-1 w-full border rounded-xl p-2.5 bg-white"><option value="1">No</option><option value="1.5">Yes, 24hr (+50%)</option></select></label>
</div>

<div class="bg-[#f4f4f5] rounded-2xl p-5 mt-4 flex items-center justify-between">
<div><div class="text-sm text-gray-600">Quote to client</div>
<div id="out" class="text-4xl font-extrabold">₹ 7,500</div>
<div id="out2" class="text-sm text-gray-600">5 min × ₹1500/min</div></div>
<span class="text-2xl bg-white rounded-full w-11 h-11 flex items-center justify-center">✂️</span>
</div>

<details class="mt-4 border rounded-2xl p-4 text-sm">
<summary class="font-bold cursor-pointer flex items-center gap-2">✂️ How this is calculated? <span class="ml-auto">⌄</span></summary>
<p id="break" class="mt-2 text-gray-600">Base ₹7,500 + revisions ₹0 × urgency 1x</p>
</details>

<div class="bg-[#f8f9fb] border rounded-2xl p-4 mt-4 text-sm flex gap-2">
<span>ⓘ</span><span><b>Tip:</b> Charge per project, not per hour. Factor in revisions and your experience.</span>
</div>
<div class="mt-3 flex items-center gap-2">
<button id="share" class="text-sm font-bold border rounded-full px-4 py-2 hover:border-indigo-500">Copy result link</button>
<span id="shareMsg" class="text-xs text-green-600"></span>
</div>
</div>
</div>
</main>
<script>
function c(){
const l=+document.getElementById('len').value||0;
const t=+document.getElementById('type').value||0;
const r=+document.getElementById('rev').value||0;
const u=+document.getElementById('urg').value||1;
let base=l*t;
let extra=r>2?(r-2)*0.25*base:0;
let total=(base+extra)*u;
document.getElementById('out').innerText='₹ '+Math.round(total).toLocaleString('en-IN');
document.getElementById('out2').innerText=l+' min × ₹'+t+'/min';
document.getElementById('break').innerText='Base ₹'+Math.round(base).toLocaleString('en-IN')+' + revisions ₹'+Math.round(extra).toLocaleString('en-IN')+' × urgency '+u+'x';
}
['len','rev','urg'].forEach(id=>document.getElementById(id).addEventListener('change',c));
['len'].forEach(id=>document.getElementById(id).addEventListener('input',c));
document.getElementById('type').addEventListener('change',c);
(function(){const q=new URLSearchParams(location.search);const l=+q.get('len');if(l>0)document.getElementById('len').value=l;const t=+q.get('type');if(t>0)document.getElementById('type').value=t;c();})();
document.getElementById('share').addEventListener('click',()=>{
const p=new URLSearchParams({len:document.getElementById('len').value,type:document.getElementById('type').value});
const link=location.origin+location.pathname+'?'+p.toString();
if(navigator.clipboard){navigator.clipboard.writeText(link).then(()=>{document.getElementById('shareMsg').innerText='Link copied ✓';});}else{prompt('Copy your result link:',link);}
});
</script>
</Layout>
