---
import Layout from '../../layouts/Layout.astro';
const title = "Freelance Rate Calculator - SetupKaro";
const desc = "Find how much to charge per hour based on your expenses, work hours and profit. Includes Upwork 10% cut.";
---
<Layout title={title} desc={desc} crumbs={[{label:'Home',href:'/'},{label:'Tools',href:'/#tools'},{label:'Freelance Rate Calculator'}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="dk-card mt-4 p-6 sm:p-8" style="background:#fffdf7">
<div class="text-xs text-gray-500">By Noyel G • Updated 6 Sept 2026</div>
<h1 class="text-2xl sm:text-3xl font-extrabold mt-1">Freelance rate calculator</h1>
<p class="text-sm text-gray-600 mt-1">Find how much to charge per hour based on your expenses, work hours and profit. Includes Upwork 10% cut.</p>

<div class="mt-5 max-w-xl">
<label class="text-sm font-semibold block">Monthly expenses (INR)</label>
<input id="expN" type="number" value="30000" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" />
<input id="exp" type="range" min="0" max="200000" step="1000" value="30000" class="w-full accent-gray-900 mt-2" />
<div class="flex justify-between text-xs text-gray-500"><span>0</span><span id="v-exp" class="font-semibold text-gray-700">30,000</span><span>2,00,000</span></div>

<div class="grid grid-cols-2 gap-3 mt-4">
<label class="text-sm font-semibold block">Hours per day<input id="hrs" type="number" value="5" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block">Days per month<input id="days" type="number" value="22" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block">Upwork fee %<input id="fee" type="number" value="10" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block">Profit %<input id="profit" type="number" value="20" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
</div>

<div class="bg-[#eef4ff] rounded-2xl p-5 mt-5">
<div class="text-sm text-gray-600">You should charge</div>
<div id="out" class="text-4xl font-extrabold">₹ 364 / hour</div>
<div id="out2" class="text-sm text-gray-600 mt-1">Monthly target: ₹40,000 for 110 hours</div>
<div class="grid grid-cols-3 gap-2 mt-4 text-center">
<div><div id="c1" class="font-extrabold">₹273</div><div class="text-xs text-gray-500">Cost / hr</div></div>
<div class="font-bold text-gray-400 self-center">+</div>
<div><div id="c2" class="font-extrabold">₹327</div><div class="text-xs text-gray-500">Profit / hr</div></div>
</div>
<div class="grid grid-cols-2 gap-2 mt-2 text-center">
<div class="font-bold text-gray-400 self-center text-right">=</div>
<div><div id="c3" class="font-extrabold">₹364</div><div class="text-xs text-gray-500">After 10% fee</div></div>
</div>
</div>

<div class="bg-[#f8f9fb] border rounded-2xl p-4 mt-4 text-sm flex gap-2">
<span>💡</span><span><b>Tip:</b> Adjust profit % based on your goals and savings. You can always charge more for specialised skills.</span>
</div>
<div class="text-sm mt-4">Related: <a href="/tools/upwork-fees-calculator" class="text-indigo-700 font-bold">Upwork fees →</a> | <a href="/tools/editing-rate-calculator" class="text-indigo-700 font-bold">Editing rate →</a> | <a href="/tools/youtube-setup-under-5000" class="text-indigo-700 font-bold">Setup builder →</a></div>
<div class="mt-3 flex items-center gap-2">
<button id="share" class="text-sm font-bold border rounded-full px-4 py-2 hover:border-indigo-500">Copy result link</button>
<span id="shareMsg" class="text-xs text-green-600"></span>
</div>
</div>
</div>
</main>
<script>
function calc(){
const e=+document.getElementById('exp').value||0;
document.getElementById('expN').value=e;
document.getElementById('v-exp').innerText=e.toLocaleString('en-IN');
const h=+document.getElementById('hrs').value||1;
const d=+document.getElementById('days').value||1;
const f=+document.getElementById('fee').value||0;
const p=+document.getElementById('profit').value||0;
const hrs=h*d||1; const cost=e/hrs; const withP=cost*(1+p/100); const ch=withP/(1-f/100);
document.getElementById('out').innerText='₹ '+Math.round(ch).toLocaleString('en-IN')+' / hour';
document.getElementById('out2').innerText='Monthly target: ₹'+Math.round(ch*hrs).toLocaleString('en-IN')+' for '+hrs+' hours';
document.getElementById('c1').innerText='₹'+Math.round(cost).toLocaleString('en-IN');
document.getElementById('c2').innerText='₹'+Math.round(withP).toLocaleString('en-IN');
document.getElementById('c3').innerText='₹'+Math.round(ch).toLocaleString('en-IN');
}
['exp','hrs','days','fee','profit'].forEach(id=>document.getElementById(id).addEventListener('input',calc));
document.getElementById('expN').addEventListener('input',()=>{document.getElementById('exp').value=document.getElementById('expN').value||0;calc();});
(function(){const q=new URLSearchParams(location.search);['exp','hrs','days','fee','profit'].forEach(id=>{const v=+q.get(id);if(v>0)document.getElementById(id).value=v;});document.getElementById('expN').value=document.getElementById('exp').value;calc();})();
document.getElementById('share').addEventListener('click',()=>{
const p=new URLSearchParams({exp:document.getElementById('exp').value,hrs:document.getElementById('hrs').value,days:document.getElementById('days').value,fee:document.getElementById('fee').value,profit:document.getElementById('profit').value});
const link=location.origin+location.pathname+'?'+p.toString();
if(navigator.clipboard){navigator.clipboard.writeText(link).then(()=>{document.getElementById('shareMsg').innerText='Link copied ✓';});}else{prompt('Copy your result link:',link);}
});
</script>
</Layout>
