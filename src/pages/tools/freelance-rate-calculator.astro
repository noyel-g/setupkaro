---
import '../../styles/global.css';
const title = "Freelance Rate Calculator India (INR, Upwork Fees) - SetupKaro";
const desc = "Calculate freelance hourly rate in INR with Upwork 10% fee for Indian beginners.";
---
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title><meta name="description" content={desc} />
</head>
<body class="bg-gradient-to-b from-indigo-50 to-white min-h-screen text-gray-900">
<header class="max-w-2xl mx-auto px-4 pt-6 flex items-center justify-between">
<a href="/" class="font-extrabold text-indigo-700 text-lg">⚙️ SetupKaro</a>
<span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full">Free • No login</span>
</header>
<main class="max-w-2xl mx-auto px-4 pb-10">
<h1 class="text-3xl font-extrabold mt-4 leading-tight">How much to charge per hour?</h1>
<p class="text-gray-600 mt-1">Made for India. Includes Upwork 10% cut + profit.</p>

<div class="bg-white rounded-2xl shadow-lg border mt-5 overflow-hidden">
<div class="bg-indigo-600 text-white px-5 py-4">
<div class="text-xs opacity-80">YOU MUST CHARGE</div>
<div id="out" class="text-4xl font-extrabold">Rs 0/hr</div>
<div id="out2" class="text-xs opacity-90 mt-1"></div>
</div>
<div class="p-5 space-y-4">
<label class="block"><div class="flex justify-between text-sm font-semibold"><span>Monthly expenses</span><span id="v-exp" class="text-indigo-600">Rs 30,000</span></div>
<input id="exp" type="range" min="5000" max="150000" step="1000" value="30000" class="w-full accent-indigo-600" /></label>
<div class="grid grid-cols-2 gap-3">
<label class="bg-gray-50 border rounded-xl p-3 block"><div class="text-xs font-bold">HOURS / DAY</div><input id="hrs" type="number" value="5" class="w-full bg-transparent text-xl font-bold outline-none" /></label>
<label class="bg-gray-50 border rounded-xl p-3 block"><div class="text-xs font-bold">DAYS / MONTH</div><input id="days" type="number" value="22" class="w-full bg-transparent text-xl font-bold outline-none" /></label>
</div>
<div class="grid grid-cols-2 gap-3">
<label class="bg-gray-50 border rounded-xl p-3 block"><div class="text-xs font-bold">UPWORK FEE %</div><input id="fee" type="number" value="10" class="w-full bg-transparent text-xl font-bold outline-none" /></label>
<label class="bg-gray-50 border rounded-xl p-3 block"><div class="text-xs font-bold">PROFIT %</div><input id="profit" type="number" value="20" class="w-full bg-transparent text-xl font-bold outline-none" /></label>
</div>
<div id="break" class="text-sm bg-gray-50 rounded-xl p-3 leading-6"></div>
</div>
</div>

<div class="bg-gray-900 text-white rounded-2xl p-5 mt-4 text-center">
<div class="font-bold">Charging right? Now need clients.</div>
<div class="text-sm opacity-70">Portfolio site = 3x replies</div>
<a href="#" class="inline-block bg-yellow-400 text-black font-bold px-5 py-2 rounded-full mt-3">Portfolio guide - coming soon</a>
</div>

<details class="mt-5 bg-white rounded-xl border p-4 text-sm"><summary class="font-bold cursor-pointer">How calculation works? Example</summary><p class="mt-2 text-gray-600">30,000 / 110hrs = Rs 273 cost +20% = Rs 327. To keep 327 after 10% fee, charge 327/0.9 = Rs 363. Round to Rs 400.</p></details>
</main>
<script>
function calc(){
const e=+document.getElementById('exp').value||0;
const h=+document.getElementById('hrs').value||1;
const d=+document.getElementById('days').value||1;
const f=+document.getElementById('fee').value||0;
const p=+document.getElementById('profit').value||0;
document.getElementById('v-exp').innerText='Rs '+e.toLocaleString('en-IN');
const hrs=h*d||1; const cost=e/hrs; const withP=cost*(1+p/100); const ch=withP/(1-f/100);
document.getElementById('out').innerText='Rs '+Math.round(ch).toLocaleString('en-IN')+'/hr';
document.getElementById('out2').innerText='Monthly target Rs '+Math.round(ch*hrs).toLocaleString('en-IN')+' for '+hrs+' hrs';
document.getElementById('break').innerHTML='Cost: <b>Rs '+Math.round(cost)+'</b> | +profit: <b>Rs '+Math.round(withP)+'</b> | After Upwork '+f+'%: <b>Rs '+Math.round(ch)+'</b>';
}
['exp','hrs','days','fee','profit'].forEach(id=>document.getElementById(id).addEventListener('input',calc));calc();
</script>
</body>
</html>
