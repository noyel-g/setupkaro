---
const title = "Freelance Rate Calculator India (INR, Upwork Fees) - SetupKaro";
const desc = "Calculate your freelance hourly rate in INR with Upwork 10% fee, monthly expenses and hours. Made for Indian beginners.";
---
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={desc} />
<script type="application/ld+json">
{JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much should a beginner freelancer charge in India?","acceptedAnswer":{"@type":"Answer","text":"Rs 300-800/hr for editing/design/writing. Calculate expenses/hours first, then add 20% profit."}},{"@type":"Question","name":"What is Upwork fee in India?","acceptedAnswer":{"@type":"Answer","text":"10% flat on most contracts now. Our calculator deducts it automatically."}},{"@type":"Question","name":"How to convert USD rate to INR?","acceptedAnswer":{"@type":"Answer","text":"Multiply USD by 83 and minus 10% fee and PayPal/Wise cut ~4%."}}]})}
</script>
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900">
<main class="max-w-2xl mx-auto p-4">
<a href="/" class="text-sm text-blue-600">← SetupKaro</a>
<h1 class="text-2xl font-bold mt-2">Freelance Rate Calculator India</h1>
<p class="text-gray-600 mt-1">Hourly rate in INR with Upwork cut. For beginners with mobile/laptop.</p>

<div class="bg-white p-4 rounded-xl shadow mt-4 space-y-3">
<label class="block">Monthly expenses Rs<input id="exp" type="number" value="30000" class="mt-1 w-full border rounded p-2" /></label>
<div class="grid grid-cols-2 gap-3">
<label class="block">Hours/day<input id="hrs" type="number" value="5" class="mt-1 w-full border rounded p-2" /></label>
<label class="block">Days/month<input id="days" type="number" value="22" class="mt-1 w-full border rounded p-2" /></label>
</div>
<div class="grid grid-cols-2 gap-3">
<label class="block">Upwork fee %<input id="fee" type="number" value="10" class="mt-1 w-full border rounded p-2" /></label>
<label class="block">Profit %<input id="profit" type="number" value="20" class="mt-1 w-full border rounded p-2" /></label>
</div>
<div class="bg-green-50 p-3 rounded">
<div class="text-sm">You must charge:</div>
<div id="out" class="text-3xl font-bold">Rs 0/hr</div>
<div id="out2" class="text-sm text-gray-700"></div>
</div>
</div>

<div class="bg-blue-600 text-white p-4 rounded-xl mt-4 text-center">
<div class="font-bold">Next: Make portfolio to get clients</div>
<a href="#" class="inline-block bg-white text-blue-700 px-4 py-2 rounded mt-2 font-bold">Coming soon</a>
</div>

<div class="mt-6 text-sm leading-6">
<h2 class="font-bold text-lg">How to use</h2>
<p>Example: Rs 30000 expenses / (5hrs x 22 days=110hrs) = Rs 273/hr cost. +20% profit = Rs 327/hr. After 10% Upwork cut you need Rs 363/hr to take home Rs 327. Round to Rs 400/hr for beginners.</p>
<h2 class="font-bold text-lg mt-3">FAQ</h2>
<p><b>Beginner rate?</b> Rs 300-800/hr. Start 400, raise after 5 reviews.</p>
<p><b>Upwork fee?</b> 10% flat now.</p>
<p><b>USD to INR?</b> $10/hr x 83 = Rs 830 -10% = Rs 747 in hand.</p>
</div>
</main>
<script>
function calc(){
const e=+document.getElementById('exp').value||0;
const h=+document.getElementById('hrs').value||1;
const d=+document.getElementById('days').value||1;
const f=+document.getElementById('fee').value||0;
const p=+document.getElementById('profit').value||0;
const hrs=h*d||1;
const cost=e/hrs;
const withProfit=cost*(1+p/100);
const charge=withProfit/(1-f/100);
document.getElementById('out').innerText='Rs '+Math.round(charge).toLocaleString('en-IN')+'/hr';
document.getElementById('out2').innerText='Cost Rs '+Math.round(cost)+'/hr | With profit Rs '+Math.round(withProfit)+'/hr | Monthly target Rs '+Math.round(charge*hrs).toLocaleString('en-IN');
}
['exp','hrs','days','fee','profit'].forEach(id=>document.getElementById(id).addEventListener('input',calc));calc();
</script>
</body>
</html>