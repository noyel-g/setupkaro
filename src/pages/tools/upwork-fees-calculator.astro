---
import Layout from '../../layouts/Layout.astro';
const title = "Upwork Fees Calculator (India) - SetupKaro";
const desc = "See how much you'll actually get in INR after Upwork fees and withdrawal charges.";
---
<Layout title={title} desc={desc} crumbs={[{label:'Home',href:'/'},{label:'Tools',href:'/#tools'},{label:'Upwork Fees Calculator'}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="bg-white rounded-3xl border mt-4 p-6 sm:p-8">
<div class="text-xs text-gray-500">By Noyel G • Updated 6 Sept 2026</div>
<h1 class="text-2xl sm:text-3xl font-extrabold mt-1">Upwork fees calculator (India)</h1>
<p class="text-sm text-gray-600 mt-1">See how much you'll actually get in INR after Upwork fees and withdrawal charges.</p>

<div class="mt-5 max-w-xl">
<label class="text-sm font-semibold block">Hourly rate (USD)</label>
<div class="relative mt-1"><span class="absolute left-3 top-2.5 text-gray-500">$</span><input id="usd" type="number" value="15" class="w-full border rounded-xl p-2.5 pl-7 font-semibold" /></div>
<div class="grid grid-cols-2 gap-3 mt-3">
<label class="text-sm font-semibold block">Hours<input id="hrs" type="number" value="20" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block">$ to INR<input id="rate" type="number" value="83" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block">Upwork fee %<input id="fee" type="number" value="10" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
<label class="text-sm font-semibold block">Withdrawal fee %<input id="wd" type="number" value="4" class="mt-1 w-full border rounded-xl p-2.5 font-semibold" /></label>
</div>

<div class="bg-[#eef4ff] rounded-2xl p-5 mt-5 flex items-center justify-between">
<div><div class="text-sm text-gray-600">You get in bank</div>
<div id="out" class="text-4xl font-extrabold">₹ 21,514</div>
<div id="out2" class="text-sm text-gray-600 mt-1">$300 billed → ₹24,900 gross</div></div>
<span class="text-3xl bg-white border rounded-2xl w-12 h-12 flex items-center justify-center">🏦</span>
</div>

<div class="mt-3 text-sm divide-y bg-white">
<div class="flex justify-between py-2"><span class="text-gray-600">Gross amount</span><b id="r1">₹24,900</b></div>
<div class="flex justify-between py-2"><span class="text-gray-600">After Upwork 10%</span><b id="r2">₹22,410</b></div>
<div class="flex justify-between py-2"><span class="text-gray-600">After withdrawal 4%</span><b id="r3">₹21,514</b></div>
</div>

<div class="bg-[#f8f9fb] border rounded-2xl p-4 mt-4 text-sm flex gap-2">
<span class="text-indigo-500">ⓘ</span><span>Rates are estimates. Actual conversion rate may vary based on your bank or withdrawal method.</span>
</div>
<div class="mt-3 flex items-center gap-2">
<button id="share" class="text-sm font-bold border rounded-full px-4 py-2 hover:border-indigo-500">Copy result link</button>
<span id="shareMsg" class="text-xs text-green-600"></span>
</div>
</div>
</div>
</main>
<script>
function c(){
const u=+document.getElementById('usd').value||0;
const h=+document.getElementById('hrs').value||0;
const r=+document.getElementById('rate').value||83;
const f=+document.getElementById('fee').value||0;
const w=+document.getElementById('wd').value||0;
const gross=u*h*r;
const afterFee=gross*(1-f/100);
const net=afterFee*(1-w/100);
document.getElementById('out').innerText='₹ '+Math.round(net).toLocaleString('en-IN');
document.getElementById('out2').innerText='$'+(u*h).toLocaleString()+' billed → ₹'+Math.round(gross).toLocaleString('en-IN')+' gross';
document.getElementById('r1').innerText='₹'+Math.round(gross).toLocaleString('en-IN');
document.getElementById('r2').innerText='₹'+Math.round(afterFee).toLocaleString('en-IN');
document.getElementById('r3').innerText='₹'+Math.round(net).toLocaleString('en-IN');
}
['usd','hrs','rate','fee','wd'].forEach(id=>document.getElementById(id).addEventListener('input',c));
(function(){const q=new URLSearchParams(location.search);['usd','hrs','rate','fee','wd'].forEach(id=>{const v=+q.get(id);if(v>0)document.getElementById(id).value=v;});c();})();
document.getElementById('share').addEventListener('click',()=>{
const p=new URLSearchParams({usd:document.getElementById('usd').value,hrs:document.getElementById('hrs').value,rate:document.getElementById('rate').value,fee:document.getElementById('fee').value,wd:document.getElementById('wd').value});
const link=location.origin+location.pathname+'?'+p.toString();
if(navigator.clipboard){navigator.clipboard.writeText(link).then(()=>{document.getElementById('shareMsg').innerText='Link copied ✓';});}else{prompt('Copy your result link:',link);}
});

</script>
</Layout>
