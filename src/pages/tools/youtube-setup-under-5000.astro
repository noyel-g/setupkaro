---
import Layout from '../../layouts/Layout.astro';
const title = "YouTube Setup Under ₹5000 - SetupKaro";
const desc = "Tick what you need. Total updates live. No overspending.";
const items = [
  { name: 'Boya BY-M1 Mic (wired, best starter)', price: 999, tag: 'Must have', icon: '🎤', on: true },
  { name: 'K8 Wireless Mic (Type-C + iPhone)', price: 1499, tag: 'Reels', icon: '🎤', on: false },
  { name: '10-inch Ring Light with stand', price: 899, tag: 'Face videos', icon: '💡', on: false },
  { name: 'Mini Tripod + mobile holder', price: 499, tag: 'Essential', icon: '📷', on: true },
];
---
<Layout title={title} desc={desc} crumbs={[{label:'Home',href:'/'},{label:'Guides',href:'/#tools'},{label:'YouTube Setup'}]}>
<main class="max-w-5xl mx-auto px-4 pb-10">
<div class="dk-card mt-4 p-6 sm:p-8" style="background:#fffdf7">
<div class="text-xs text-gray-500">By Noyel G • Updated 6 Sept 2026</div>
<h1 class="text-2xl sm:text-3xl font-extrabold mt-1">YouTube setup under ₹5000?</h1>
<p class="text-sm text-gray-600 mt-1">Tick what you need. Total updates live. No overspending.</p>
<div class="mt-5 max-w-xl space-y-3" id="list">
{items.map((it) => (
<label class="border rounded-2xl p-4 flex gap-3 items-center cursor-pointer hover:border-indigo-400 bg-white">
<input type="checkbox" data-price={it.price} class="chk w-5 h-5 accent-blue-600" checked={it.on} />
<span class="text-3xl">{it.icon}</span>
<span class="flex-1"><span class="font-semibold text-sm block">{it.name}</span><span class="text-xs text-gray-500">₹{it.price.toLocaleString('en-IN')} • {it.tag}</span></span>
</label>
))}
</div>
<div class="max-w-xl mt-4 flex items-center justify-between">
<div><div class="text-sm font-semibold">Total</div><div id="total" class="text-4xl font-extrabold">₹1,498</div></div>
<div class="text-right"><span id="badge" class="text-xs font-bold bg-green-100 text-green-700 px-3 py-1 rounded-full">Under ₹5000</span><div id="msg" class="text-xs text-gray-500 mt-1">Perfect starter – start creating today!</div></div>
</div>
</div>
</main>
<script>
function upd(){
let t=0; document.querySelectorAll('.chk:checked').forEach(c=>t+=+c.dataset.price);
document.getElementById('total').innerText='₹'+t.toLocaleString('en-IN');
const b=document.getElementById('badge'); const m=document.getElementById('msg');
if(t<=5000){b.innerText='Under ₹5000';b.className='text-xs font-bold bg-green-100 text-green-700 px-3 py-1 rounded-full';m.innerText='Perfect starter – start creating today!';}
else if(t<=10000){b.innerText='Under ₹10000';b.className='text-xs font-bold bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full';m.innerText='Semi-pro setup';}
else{b.innerText='Over budget';b.className='text-xs font-bold bg-red-100 text-red-700 px-3 py-1 rounded-full';m.innerText='Remove one item';}
}
document.querySelectorAll('.chk').forEach(c=>c.addEventListener('change',upd));upd();
</script>
</Layout>
